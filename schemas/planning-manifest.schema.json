{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CyanGdEv/Voxel-Mapping-Tool/schemas/planning-manifest.schema.json",
  "title": "Voxel Mapping Tool planning manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "authority", "documents"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "parkId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "reviewedAt": { "type": "string", "format": "date" },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "officialPortal"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "officialPortal": { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    },
    "documents": {
      "type": "array",
      "items": { "$ref": "#/$defs/document" }
    }
  },
  "$defs": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "applicationReference", "applicationStatus", "reuseStatus"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "applicationReference": { "type": "string", "minLength": 1 },
        "applicationStatus": { "type": "string", "minLength": 1 },
        "role": { "type": "string" },
        "sourceUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
        "file": { "type": "string", "minLength": 1 },
        "mime": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "acquire": { "type": "boolean" },
        "reuseStatus": { "type": "string", "minLength": 1 },
        "publishedAt": { "type": "string", "format": "date" },
        "decisionDate": { "type": "string", "format": "date" },
        "derivedGeojson": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          ]
        },
        "worldEligible": { "type": "boolean" },
        "worldEligibilityBasis": { "type": "string", "minLength": 10 },
        "evidenceFor": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "anyOf": [
        { "required": ["sourceUrl"] },
        { "required": ["file"] },
        { "required": ["derivedGeojson"] }
      ],
      "allOf": [
        {
          "if": { "required": ["derivedGeojson"] },
          "then": { "required": ["worldEligible"] }
        },
        {
          "if": { "properties": { "worldEligible": { "const": true } }, "required": ["worldEligible"] },
          "then": { "required": ["worldEligibilityBasis"] }
        }
      ]
    }
  }
}
